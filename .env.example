# Copia este archivo a .env.local para desarrollo (npm run dev).
# Los valores están en Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Opcional: número del asistente de WhatsApp de la landing, con código de país (p. ej. 56912345678)
VITE_WHATSAPP_NUMBER=

# En producción (Docker / Easypanel / npm start) define en su lugar:
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key
# WHATSAPP_NUMBER=56912345678
# PORT=3000

# --- WhatsApp Business (Cloud API) y sistema de lealtad: solo el servidor (server.js) las lee ---
# npm start las toma de .env; en Easypanel van en Environment. Nunca uses el prefijo VITE_ con ellas:
# lo que empieza con VITE_ termina en el navegador.
# Clave service_role de Supabase (Project Settings > API). Guarda y lee los tokens de WhatsApp.
# SUPABASE_SERVICE_ROLE_KEY=
# App de Meta (developers.facebook.com > tu app > Configuración > Básica)
# META_APP_ID=
# META_APP_SECRET=
# Texto que inventas y pegas en la app de Meta al configurar el webhook (https://tu-dominio/api/whatsapp/webhook)
# META_WEBHOOK_VERIFY_TOKEN=
# Opcional
# META_GRAPH_VERSION=v24.0
