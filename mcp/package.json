{
  "name": "smartqr-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Servidor MCP para administrar la carta de un negocio en SmartQR",
  "type": "module",
  "bin": {
    "smartqr-mcp": "dist/src/index.js",
    "smartqr-mcp-http": "dist/src/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
